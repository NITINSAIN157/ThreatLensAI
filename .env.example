# ==============================================================================
# ThreatLens AI - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Optional for RAG answers)
# If left empty, ThreatLens uses its local grounded extractive synthesis engine.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./vector_store

# Model & Decision Thresholds
DEFAULT_DETECTION_THRESHOLD=0.50
RANDOM_SEED=42
